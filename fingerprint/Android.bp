// Forwards the fingerprint AIDL surface to the original HAL.
//
// Built against the V2 ndk library to match the original HAL, which
// extract-files.py rewrites to link android.hardware.biometrics.fingerprint-V2-ndk.so.
// V1 was tried first and boot-looped system_server: FingerprintService reads
// SensorProps using the framework's current struct layout, and a V1 server
// writes a shorter parcel than that layout expects, so getSensorProps() throws
// IllegalArgumentException during BiometricServiceRegistry startup.
cc_binary {
    name: "android.hardware.biometrics.fingerprint-service.proxy",
    srcs: ["FingerprintProxy.cpp"],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "liblog",
    ],
    static_libs: [
        "android.hardware.biometrics.fingerprint-V4-ndk",
        "android.hardware.biometrics.common-V4-ndk",
        "android.hardware.keymaster-V4-ndk",
    ],
    vendor: true,
    proprietary: true,
    init_rc: ["fingerprint-proxy.rc"],
    vintf_fragments: ["fingerprint-proxy.xml"],
    lto: {
        never: true,
    },
}
